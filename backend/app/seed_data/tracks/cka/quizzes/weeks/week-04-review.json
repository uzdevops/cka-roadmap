      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "A rollout is one ReplicaSet scaling up while another scales down.",
      "points": 1
    },
    {
      "key": "w4-q2",
      "type": "fill_command",
      "prompt": "Write the command that rolls Deployment web back one revision.",
      "options": [],
      "correct_options": [],
      "accepted_answers": [
        "kubectl rollout undo deployment/web",
        "kubectl rollout undo deployment web",
        "kubectl rollout undo deploy/web",
        "kubectl rollout undo deploy web"
      ],
      "explanation": "Old ReplicaSets are retained precisely to make this possible.",
      "points": 2
    },
    {
      "key": "w4-q3",
      "type": "single_choice",
      "prompt": "Why is a Deployment's spec.selector immutable?",
      "options": [
        {
          "id": "a",
          "text": "To save storage"
        },
        {
          "id": "b",
          "text": "Changing it would orphan the ReplicaSets and Pods it owns"
        },
        {
          "id": "c",
          "text": "RBAC forbids it"
        },
        {
          "id": "d",
          "text": "It is not immutable"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "Ownership in Kubernetes is a label query; move the query and you lose the children.",
      "points": 1
    },
