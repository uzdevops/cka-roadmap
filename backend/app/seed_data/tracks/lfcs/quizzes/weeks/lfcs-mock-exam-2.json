    {
      "key": "l2-01",
      "type": "single_choice",
      "prompt": "Which command shows the last 50 journal lines for sshd and follows?",
      "options": [
        {
          "id": "a",
          "text": "journalctl -u sshd -n 50 -f"
        },
        {
          "id": "b",
          "text": "tail -f /var/log/sshd"
        },
        {
          "id": "c",
          "text": "systemctl log sshd"
        },
        {
          "id": "d",
          "text": "dmesg | grep sshd"
        }
      ],
      "correct_options": [
        "a"
      ],
      "accepted_answers": [],
      "explanation": "-u filters by unit, -n limits, -f follows.",
      "points": 1
    },
    {
      "key": "l2-02",
      "type": "single_choice",
      "prompt": "What does the sticky bit on /tmp do?",
      "options": [
        {
          "id": "a",
          "text": "Makes files executable"
        },
        {
          "id": "b",
          "text": "Only a file's owner may delete it"
        },
        {
          "id": "c",
          "text": "Runs files as the directory owner"
        },
        {
          "id": "d",
          "text": "Disables writes"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "On a world-writable directory the sticky bit restricts deletion to the owner.",
      "points": 1
    },
