      "key": "l3-01",
      "type": "single_choice",
      "prompt": "Which command sets the hostname persistently?",
      "options": [
        {
          "id": "a",
          "text": "hostname node1"
        },
        {
          "id": "b",
          "text": "hostnamectl set-hostname node1"
        },
        {
          "id": "c",
          "text": "echo node1 > /proc/sys/kernel/hostname"
        },
        {
          "id": "d",
          "text": "nmcli gen hostname"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "hostnamectl writes /etc/hostname and sets it live.",
      "points": 1
    },
    {
