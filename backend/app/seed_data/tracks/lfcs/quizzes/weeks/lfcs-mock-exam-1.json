    {
      "key": "l1-10",
      "type": "single_choice",
      "prompt": "Which command extends an LV by 1G and grows the filesystem in one step?",
      "options": [
        {
          "id": "a",
          "text": "lvextend -L +1G -r"
        },
        {
          "id": "b",
          "text": "lvresize --fs"
