    {
      "key": "l1-13",
      "type": "single_choice",
      "prompt": "Which command restores default SELinux contexts under /var/www?",
      "options": [
        {
          "id": "a",
          "text": "chcon -R /var/www"
        },
        {
          "id": "b",
          "text": "restorecon -Rv /var/www"
        },
        {
          "id": "c",
          "text": "setenforce 0"
        },
        {
          "id": "d",
          "text": "semanage reset"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "restorecon relabels from policy; chcon sets an arbitrary context that restorecon would undo.",
      "points": 1
