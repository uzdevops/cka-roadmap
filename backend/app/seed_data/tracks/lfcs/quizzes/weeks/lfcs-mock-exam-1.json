      "prompt": "Which option to mount makes binaries on the filesystem unrunnable?",
      "options": [
        {
          "id": "a",
          "text": "nosuid"
        },
        {
          "id": "b",
          "text": "noexec"
        },
        {
          "id": "c",
          "text": "ro"
        },
        {
          "id": "d",
          "text": "noatime"
