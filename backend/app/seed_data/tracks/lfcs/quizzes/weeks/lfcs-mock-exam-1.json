  "questions": [
    {
      "key": "l1-01",
      "type": "single_choice",
      "prompt": "Which command shows which package owns /usr/bin/rsync on a Debian-based system?",
      "options": [
        {
          "id": "a",
          "text": "apt owns /usr/bin/rsync"
        },
        {
          "id": "b",
          "text": "dpkg -S /usr/bin/rsync"
        },
        {
          "id": "c",
          "text": "rpm -qf /usr/bin/rsync"
        },
        {
          "id": "d",
          "text": "which rsync"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "dpkg -S searches the installed file lists; rpm -qf is the RPM equivalent.",
      "points": 1
    },
    {
      "key": "l1-02",
      "type": "single_choice",
      "prompt": "What does chmod 4755 set on a file?",
      "options": [
        {
          "id": "a",
          "text": "sticky bit"
        },
        {
          "id": "b",
          "text": "SGID"
        },
        {
          "id": "c",
          "text": "SUID with rwxr-xr-x"
        },
        {
          "id": "d",
          "text": "no special bits"
        }
      ],
      "correct_options": [
        "c"
      ],
      "accepted_answers": [],
      "explanation": "The leading 4 is SUID; 755 is the ordinary mode.",
      "points": 1
    },
    {
      "key": "l1-03",
      "type": "single_choice",
      "prompt": "Which systemd command makes a service start at boot AND starts it now?",
      "options": [
        {
          "id": "a",
          "text": "systemctl start"
        },
        {
          "id": "b",
          "text": "systemctl enable --now"
        },
        {
          "id": "c",
          "text": "systemctl reload"
        },
        {
          "id": "d",
          "text": "systemctl mask"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "enable creates the boot link; --now also starts it immediately.",
      "points": 1
    },
    {
      "key": "l1-04",
      "type": "single_choice",
      "prompt": "A hard link and its original: how many inodes?",
      "options": [
        {
          "id": "a",
          "text": "Two"
        },
        {
          "id": "b",
          "text": "One"
        },
        {
          "id": "c",
          "text": "Depends on the filesystem"
        },
        {
          "id": "d",
          "text": "Zero"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "A hard link is another directory entry for the same inode.",
      "points": 1
    },
    {
      "key": "l1-05",
      "type": "single_choice",
      "prompt": "Which file defines persistent kernel parameters?",
      "options": [
        {
          "id": "a",
          "text": "/proc/sys/kernel"
        },
        {
          "id": "b",
          "text": "/etc/sysctl.d/*.conf"
        },
        {
          "id": "c",
          "text": "/etc/default/grub"
        },
        {
          "id": "d",
          "text": "/etc/modules"
        }
      ],
      "correct_options": [
        "b"
      ],
      "accepted_answers": [],
      "explanation": "/etc/sysctl.conf and /etc/sysctl.d are read at boot; /proc/sys is the live view.",
      "points": 1
    },
    {
      "key": "l1-06",
      "type": "single_choice",
      "prompt": "Which crontab line runs a job at 02:15 every Sunday?",
      "options": [
        {
          "id": "a",
          "text": "15 2 * * 0"
        },
        {
          "id": "b",
          "text": "2 15 * * 7"
        },
        {
          "id": "c",
          "text": "15 2 0 * *"
        },
        {
          "id": "d",
          "text": "* 2 15 * 0"
        }
      ],
      "correct_options": [
        "a"
      ],
      "accepted_answers": [],
      "explanation": "minute hour dom month dow; Sunday is 0 (or 7).",
      "points": 1
    },
    {
