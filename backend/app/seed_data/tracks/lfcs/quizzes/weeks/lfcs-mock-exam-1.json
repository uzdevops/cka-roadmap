    {
      "key": "l1-12",
      "type": "single_choice",
      "prompt": "What does chage -d 0 bob do?",
      "options": [
        {
          "id": "a",
          "text": "Locks bob"
        },
        {
          "id": "b",
          "text": "Forces a password change at next login"
