    {
      "key": "l1-11",
      "type": "single_choice",
      "prompt": "Which firewalld command allows https permanently?",
      "options": [
        {
          "id": "a",
          "text": "firewall-cmd --add-port=443"
        },
        {
          "id": "b",
          "text": "firewall-cmd --permanent --add-service=https && firewall-cmd --reload"
        },
        {
          "id": "c",
          "text": "ufw allow https"
        },
        {
          "id": "d",
          "text": "iptables -A INPUT -p tcp --dport 443"
