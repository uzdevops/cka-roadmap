# ---------------------------------------------------------------------------
# Copy to .env only if you want to override something:
#
#     cp .env.example .env
#
# This file works AS-IS. It is also entirely optional - `docker compose up`
# runs with these exact values baked in as compose defaults.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
# Credentials for the bundled postgres:16-alpine container.
POSTGRES_USER=cka
POSTGRES_PASSWORD=cka_password
POSTGRES_DB=cka_prep
# Host port PostgreSQL is published on. Change it if 5432 is already taken on
# the host (the container port is always 5432 and never changes).
POSTGRES_PORT_HOST=5432

# --- Published ports --------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Docker network ---------------------------------------------------------
# All three services share one dedicated bridge network and reach each other by
# service name on it.
DOCKER_NETWORK=k8s

# --- Backend ----------------------------------------------------------------
# development | production - only affects logging verbosity and docs defaults.
ENVIRONMENT=development
DEBUG=false
# CHANGE THIS IN PRODUCTION. Signs JWTs and the OAuth session cookie.
# Generate one with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production-0123456789abcdef
# Lifetime of an access token, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Lifetime of a refresh token, in days.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Origin allowed by CORS. Use CORS_ORIGINS for a comma-separated list instead.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=
# Throttles /auth endpoints via slowapi. Disable only for load testing.
RATE_LIMIT_ENABLED=true

# --- Google OAuth (OPTIONAL) ------------------------------------------------
# Leave both empty and the app works fully with email/password login; the
# "Continue with Google" button is hidden automatically.
# To enable: create an OAuth client at https://console.cloud.google.com/,
# add OAUTH_REDIRECT_URL as an authorised redirect URI, then fill these in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback

# --- Features ---------------------------------------------------------------
# When true, a phase stays locked until the previous phase's quiz average
# reaches PHASE_UNLOCK_MIN_SCORE.
ENFORCE_PHASE_UNLOCK=false
# A track opens only after the user presses Start, which is what gives the
# countdown a day one. Set false to hand every track over immediately.
ENFORCE_TRACK_START=true
# Used only for a track with no phases and no weeks yet.
TRACK_DEFAULT_WEEKS=20
PHASE_UNLOCK_MIN_SCORE=70
# Runs the idempotent seeder on every backend start. Safe to leave on.
SEED_ON_START=true

# --- Demo accounts ----------------------------------------------------------
# Created by the seeder on first start. Change them for any public deployment.
DEMO_STUDENT_EMAIL=student@demo.local
DEMO_STUDENT_PASSWORD=DemoPass123!
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=AdminPass123!

# --- Frontend ---------------------------------------------------------------
# Where the BROWSER reaches the API. Must be reachable from the host machine.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where SERVER-SIDE rendering reaches the API - a container-network address.
INTERNAL_API_URL=http://backend:8000
# Public site URL, used for canonical URLs and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Language ---------------------------------------------------------------
# Locale used when the visitor has neither a saved choice nor a matching
# Accept-Language header: en | uz. Both are always reachable from the switcher
# in the header and from /en/... and /uz/... URLs.
# NOTE: this is inlined into the client bundle, so changing it needs a rebuild.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Swarm (only used by ./install.sh and docker-stack.yml) ------------------
# Stack name. `make STACK=foo stack-deploy` overrides it for one command.
STACK=cka
