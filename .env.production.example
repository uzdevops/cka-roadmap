# ---------------------------------------------------------------------------
# Production values for https://cka-prep.yatm.uz behind nginx.
#
#     cp .env.production.example .env
#     # then fill in the two generated secrets below
#     docker compose up -d --build
#
# Unlike .env.example this file does NOT work as-is: the two secrets and the
# demo passwords are placeholders on purpose.
# ---------------------------------------------------------------------------

# --- Secrets: generate these, do not ship the placeholders -------------------
#
# Use hex, not base64. The password is interpolated straight into the connection
# string (postgresql+asyncpg://user:PASSWORD@host/db), so a "/", "+", "@" or ":"
# in it silently produces a wrong DSN. "$" is worse: Docker Compose expands it
# while reading this file.
#
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_48_hex_chars
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_hex_chars

POSTGRES_USER=cka
POSTGRES_DB=cka_prep

# --- Where the ports are bound ----------------------------------------------
# nginx runs on the same host and reaches the containers over the loopback
# interface, so nothing needs to be published to the outside world. Leave these
# at 0.0.0.0 and the database and the raw API are exposed to the internet.
POSTGRES_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

POSTGRES_PORT_HOST=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_ENABLED=true

# Everything is served from one origin, so CORS never actually fires in the
# browser. Set it correctly anyway - it is the fallback if anything ever calls
# the API cross-origin.
FRONTEND_ORIGIN=https://cka-prep.yatm.uz
CORS_ORIGINS=

# --- Frontend ---------------------------------------------------------------
# Leave this EMPTY behind a reverse proxy. The browser then calls /api/v1/...
# relative to whatever origin served the page, which works over the IP and the
# domain, http and https, without caring which. Set an absolute URL only when
# the API is genuinely on another host.
#
# Empty is passed through rather than defaulted because docker-compose.yml uses
# ${NEXT_PUBLIC_API_URL-...} (no colon). Whatever you put here is compiled into
# the client bundle at image build time, so a change needs
# `docker compose up -d --build`, not just a restart.
NEXT_PUBLIC_API_URL=

# Server-side rendering stays inside the compose network.
INTERNAL_API_URL=http://backend:8000

# Canonical URLs, hreflang alternates and sitemap.xml are built from this.
NEXT_PUBLIC_SITE_URL=https://cka-prep.yatm.uz

NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Google OAuth (OPTIONAL) ------------------------------------------------
# Leave the client id and secret empty and the button stays hidden. If you fill
# them in, register the redirect URL below in the Google Cloud console exactly
# as written - the redirect is performed by the browser, so it goes through
# nginx like everything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://cka-prep.yatm.uz/api/v1/auth/google/callback
OAUTH_SUCCESS_REDIRECT=https://cka-prep.yatm.uz/auth/callback

# --- Features ---------------------------------------------------------------
ENFORCE_PHASE_UNLOCK=false
# A track opens only after the user presses Start, which is what gives the
# countdown a day one. Set false to hand every track over immediately.
ENFORCE_TRACK_START=true
# Used only for a track with no phases and no weeks yet.
TRACK_DEFAULT_WEEKS=20
PHASE_UNLOCK_MIN_SCORE=70
# Idempotent, and it fills in newly added lessons on redeploy. Safe to leave on.
SEED_ON_START=true

# --- Demo accounts ----------------------------------------------------------
# Two accounts are always created on first start, and the default credentials
# are printed in this repo's README - on a public site that is an open door to
# the admin panel. Set your own values here BEFORE the first `up`, or set
# SEED_ON_START=false if this deployment wants no demo accounts at all. The seeder matches on email and never touches a user
# that already exists, so changing these later creates new accounts rather than
# updating the old ones; delete those by hand if you get the order wrong.
#
# The username is what you type into the sign-in box; the email is still
# accepted there too. Locally these default to admin / 123 so a fresh checkout
# is usable straight away - which is exactly why DEMO_ADMIN_PASSWORD must be set
# here: the backend refuses to start in production while it is still `123`.
DEMO_STUDENT_EMAIL=student@cka-prep.yatm.uz
DEMO_STUDENT_USERNAME=student
DEMO_STUDENT_PASSWORD=CHANGE_ME_too
DEMO_ADMIN_EMAIL=admin@cka-prep.yatm.uz
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=CHANGE_ME_as_well

# --- Docker network ---------------------------------------------------------
DOCKER_NETWORK=k8s

# --- Swarm (only used by ./install.sh and docker-stack.yml) ------------------
# Stack name; every service is namespaced under it (cka_backend, cka_db, ...).
STACK=cka
#
# Under Swarm, SECRET_KEY and POSTGRES_PASSWORD above are ALSO registered as
# Docker secrets by install.sh and mounted at /run/secrets/. The backend reads
# SECRET_KEY_FILE / POSTGRES_PASSWORD_FILE first and falls back to the plain
# variable, so both deployment paths work from this one file. You do not need to
# set the *_FILE variables by hand - docker-stack.yml does it.

# --- Telegram bot (OPTIONAL) -------------------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty and there is no bot: the service exits cleanly,
# the API reports it as disabled and the UI hides every mention of it. Nothing
# else stops working.
#
# Get both from @BotFather: /newbot gives the token, and the username is the
# @name it assigns - WITHOUT the leading @, because it is pasted straight into
# https://t.me/<username>?start=<token>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# How long a link button stays valid. Long enough to reach for a phone, short
# enough that a forwarded link is already dead.
LINK_TOKEN_TTL_MINUTES=15
# When the daily nudge goes out. One time for everybody - the zone must be
# explicit because the server is usually UTC, where 20:30 is the middle of the
# night here.
REMINDER_TZ=Asia/Tashkent
REMINDER_HOUR=20
REMINDER_MINUTE=30

